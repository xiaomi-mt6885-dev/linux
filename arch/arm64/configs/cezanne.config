# Minimal cezanne bring-up configuration (merge on top of arm64 defconfig)

CONFIG_ARCH_MEDIATEK=y
# The MT6895 clock/pinctrl drivers do not describe MT6885.
# CONFIG_COMMON_CLK_MT6895 is not set
# CONFIG_PINCTRL_MT6895 is not set
CONFIG_LOCALVERSION="-cezanne"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DEFAULT_HOSTNAME="cezanne"

# Console / early console
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MT6577=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4

# Bootloader framebuffer console
CONFIG_FB=y
# CONFIG_DRM_SIMPLEDRM is not set
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_DRM_FBDEV_EMULATION=y

# AP watchdog left running by LK
CONFIG_MEDIATEK_WATCHDOG=y

# Mirror printk into LK's log_store so early hangs survive a WDT reset
CONFIG_PEARL_MARKER_WRITER=y

# pstore / ramoops
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_DEFAULT_KMSG_BYTES=262144

# The initramfs is passed as a gzip cpio in the boot image
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# Keep the Image small enough for LK's decompression buffer
CONFIG_DEBUG_INFO_NONE=y
# CONFIG_DEBUG_INFO_BTF is not set

# Xen hypervisor guest support is not needed on this phone
# CONFIG_XEN is not set
